class Solution {
public:
    int search(vector<int>& nums, int target) {
        int start = 0 , end = nums.size()-1;
        int mid = start+(end - start)/2;
        int ans = -1;

        while(start <= end){
            if(nums[mid] == target){
                ans = mid;
                end = mid-1;
            }
            else if(target > nums[mid]){
                start = mid+1;
            }
             else if(target < nums[mid]){
                end = mid-1;
            }
            mid = start+(end-start)/2;
        }
        return ans;
    }
};
