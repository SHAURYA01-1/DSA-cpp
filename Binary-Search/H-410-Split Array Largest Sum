class Solution {
public:

    bool IssPossible(vector<int>& arr, int n, int m, int mid) {

        int StudentCount = 1;
        int PageSum = 0;

        for(int i = 0; i < n; i++) {

            if(PageSum + arr[i] <= mid) {
                PageSum += arr[i];
            }
            else {

                StudentCount++;

                if(StudentCount > m || arr[i] > mid) {            
                    return false;
                }

                PageSum = arr[i];
            }
        }

        return true;
    }

    int splitArray(vector<int>& nums, int k) {

        int start = *max_element(nums.begin(), nums.end());
        int sum = 0;

        for(int i = 0; i < nums.size(); i++) {
            sum += nums[i];
        }

        int last = sum;
        int ans = -1;

        while(start <= last) {

            int mid = start + (last - start) / 2;

            if(IssPossible(nums, nums.size(), k, mid)) {
                ans = mid;
                last = mid - 1;
            }
            else {
                start = mid + 1;
            }
        }

        return ans;
    }
};
