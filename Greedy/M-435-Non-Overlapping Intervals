class Solution {
public:
    int eraseOverlapIntervals(vector<vector<int>>& intervals) {
        
        sort(intervals.begin(),intervals.end());//here we sort list for better transverse
    
        int ans = 0;

        int prevEnd = intervals[0][1];

        for(int i = 1 ; i< intervals.size();i++){//checking the index of this 2D array

        //current interval overlap with previous kept interval

        if (intervals[i][0] < prevEnd) {

                ans++;

                // Keep the interval that ends earlier
                prevEnd = min(prevEnd, intervals[i][1]);

            }
            else{
                prevEnd = intervals[i][1];
            }
        }
    return ans;

    }

};
