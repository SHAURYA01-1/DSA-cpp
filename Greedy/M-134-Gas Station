class Solution {
public:
    int canCompleteCircuit(vector<int>& gas, vector<int>& cost) {

        int currentgas = 0;
        int start = 0;

        for (int i = 0; i < gas.size(); i++) {

            currentgas += gas[i] - cost[i];

            if (currentgas < 0) {
                start = i + 1;
                currentgas = 0;
            }
        }

        int totalgas = 0;

        for (int i = 0; i < gas.size(); i++) {
            totalgas += gas[i] - cost[i];
        }

        if (totalgas < 0) {
            return -1;
        }

        return start;
    }
};
