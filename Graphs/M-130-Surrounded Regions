class Solution {
public:

    void dfs(int row, int col, vector<vector<char>>& board)
    {
        int m = board.size();
        int n = board[0].size();

        // Mark this O as safe
        board[row][col] = '#';

        int dr[] = {1, -1, 0, 0};
        int dc[] = {0, 0, -1, 1};

        for(int i = 0; i < 4; i++)
        {
            int newrow = row + dr[i];
            int newcol = col + dc[i];

            // Outside the board
            if(newrow < 0 || newrow >= m ||
               newcol < 0 || newcol >= n)
            {
                continue;
            }

            // Only visit O
            if(board[newrow][newcol] != 'O')
            {
                continue;
            }

            dfs(newrow, newcol, board);
        }
    }


    void solve(vector<vector<char>>& board)
    {
        int m = board.size();
        int n = board[0].size();


        // Top row
        for(int col = 0; col < n; col++)
        {
            if(board[0][col] == 'O')
            {
                dfs(0, col, board);
            }
        }


        // Bottom row
        for(int col = 0; col < n; col++)
        {
            if(board[m - 1][col] == 'O')
            {
                dfs(m - 1, col, board);
            }
        }


        // Left column
        for(int row = 0; row < m; row++)
        {
            if(board[row][0] == 'O')
            {
                dfs(row, 0, board);
            }
        }


        // Right column
        for(int row = 0; row < m; row++)
        {
            if(board[row][n - 1] == 'O')
            {
                dfs(row, n - 1, board);
            }
        }


        // Capture surrounded regions
        for(int i = 0; i < m; i++)
        {
            for(int j = 0; j < n; j++)
            {
                if(board[i][j] == 'O')
                {
                    board[i][j] = 'X';
                }
                else if(board[i][j] == '#')
                {
                    board[i][j] = 'O';
                }
            }
        }
    }
};
