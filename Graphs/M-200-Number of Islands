class Solution {
public:

    void dfs(vector<vector<char>>& grid, int row, int col) {

        // Boundary condition + water condition
        if(row < 0 || row >= grid.size() ||
           col < 0 || col >= grid[0].size() ||
           grid[row][col] == '0') {
            return;
        }

        // Mark current land as visited
        grid[row][col] = '0';

        // Explore UP
        dfs(grid, row - 1, col);

        // Explore DOWN
        dfs(grid, row + 1, col);

        // Explore LEFT
        dfs(grid, row, col - 1);

        // Explore RIGHT
        dfs(grid, row, col + 1);
    }

    int numIslands(vector<vector<char>>& grid) {

        int count = 0;

        for(int row = 0; row < grid.size(); row++) {

            for(int col = 0; col < grid[0].size(); col++) {

                // Found a new island
                if(grid[row][col] == '1') {

                    count++;

                    // Visit the complete island
                    dfs(grid, row, col);
                }
            }
        }

        return count;
    }
};
