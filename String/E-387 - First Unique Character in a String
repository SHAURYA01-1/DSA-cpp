here is the brute force solution which get the TLE(Time Limit Exceed):-
class Solution {
public:
    int firstUniqChar(string s) {
        for(int i = 0; i < s.size(); i++) {
            int count = 0;
            for(int j = 0; j < s.size(); j++) {
                if(s[i] == s[j]) {
                   count++;
                }
            }
            if(count == 1) {
                return i;
            }
        }
        return -1;
    }
};


NOW We go for the more optimal solution:-
class Solution {
public:
    int firstUniqChar(string s) {

        int freq[26] = {0};

        // Count frequency
        for(char ch : s) {
            freq[ch - 'a']++;
        }

        // Find first unique character
        for(int i = 0; i < s.size(); i++) {
            if(freq[s[i] - 'a'] == 1) {
                return i;
            }
        }

        return -1;
    }
};

