class Solution {
public:

    bool ans = true;

    int height(TreeNode* root) {

        if(root == NULL) {
            return 0;
        }

        int left = height(root->left);
        int right = height(root->right);

        // Check if current node is balanced
        if(abs(left - right) > 1) {
            ans = false;
        }

        return 1 + max(left, right);
    }

    bool isBalanced(TreeNode* root) {

        height(root);

        return ans;
    }
};
