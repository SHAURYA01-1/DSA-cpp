class Solution {
public:

    void solve(TreeNode* root, int level, vector<int> &ans){

        if(root == NULL){
            return ;
        }

        if(ans.size() == level){
            ans.push_back(root->val);
        }

        //go for right 1st
        solve(root->right,level+1,ans);

        //then visit the left side
        solve(root->left,level+1,ans);

    }
    vector<int> rightSideView(TreeNode* root) {
        
        vector<int> ans;

        solve(root,0,ans);

        return ans;
    }
};
