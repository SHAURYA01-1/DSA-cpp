class Solution {
public:
    int totalFruit(vector<int>& fruits) {

        unordered_map<int,int> mp;
        
        int left = 0;
        int ans = 0;
        
        for(int right = 0 ; right<fruits.size();right++){

            //Add current fruit
            mp[fruits[right]]++;

            //if more then 2 unique fruits
            while(mp.size() > 2){

                //remove the left fruits
                mp[fruits[left]]--;

                //if its counts become 0 
                //completly remove it from the map

                if(mp[fruits[left]] == 0){
                     mp.erase(fruits[left]);
                }

                //shrink the window
                left++;
            }
             // Update maximum length
            ans = max(ans, right - left + 1);
        }
        return ans;
    }
};
