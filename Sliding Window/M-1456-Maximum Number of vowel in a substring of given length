class Solution {
public:
    bool isVowel(char ch) {
        return ch == 'a' || ch == 'e' || ch == 'i' ||
               ch == 'o' || ch == 'u';
    }

    int maxVowels(string s, int k) {
        int left = 0;
        int sum = 0;
        int ans = 0;

        for (int right = 0; right < s.size(); right++) {

            // Add the right character to the window
            if (isVowel(s[right])) {
                sum++;
            }

            // When window size becomes k
            if (right - left + 1 == k) {

                // Store maximum vowels
                ans = max(ans, sum);

                // Remove left character before sliding
                if (isVowel(s[left])) {
                    sum--;
                }

                // Slide the window
                left++;
            }
        }

        return ans;
    }
};
