class Solution {
public:
    bool checkInclusion(string s1, string s2) {
        bool value = false;
       if(s1.size() > s2.size()){
        return false;
       } 

       vector<int> freq1(26,0);
       vector<int> freq2(26,0);

       //frequency s1;
       for(char ch:s1){
        freq1[ch-'a']++;
       }

       int left = 0;

       for(int right = 0 ; right<s2.size();right++){

              freq2[s2[right] - 'a']++;

              // If window becomes bigger than s1
            if (right - left + 1 > s1.size()) {
                freq2[s2[left] - 'a']--;
                left++;
            }

            // Compare when window size is equal to s1
            if (right - left + 1 == s1.size()) {
                if (freq1 == freq2) {
                    return value = true;
                }
            }

       }
       return value;
    }
};
