class Solution {
public:

   vector<vector<string>> ans;

   bool isSafe(int row, int col, vector<string>& board, int n) {

    // 1. Check same column
    for (int i = row - 1; i >= 0; i--) {
        if (board[i][col] == 'Q') {
            return false;
        }
    }

    // 2. Check upper-left diagonal
    for (int i = row - 1, j = col - 1;
         i >= 0 && j >= 0;
         i--, j--) {

        if (board[i][j] == 'Q') {
            return false;
        }
    }

    // 3. Check upper-right diagonal
    for (int i = row - 1, j = col + 1;
         i >= 0 && j < n;
         i--, j++) {

        if (board[i][j] == 'Q') {
            return false;
        }
    }

    return true;
}

    void Solve(int row,int n,vector<string> & board){
        //All Queen are placed
        if(row == n){
            ans.push_back(board);
            return;
        }
        //Trying placing Queen in every column.
        for(int col = 0; col < n; col++){

            if(isSafe(row,col,board,n)){

                //Choose
                board[row][col] = 'Q';

                //explore next row
                Solve(row+1,n,board);

                //Back-track
                board[row][col] = '.';
            }
        }
    }
    vector<vector<string>> solveNQueens(int n) {
        vector<string> board(n,string(n,'.'));

        Solve(0,n,board);

        return ans;
    }
};
