class Solution {
public:
    vector<string> ans;

    void solve(int open, int close, int n, string path) {

        // Base case
        if (path.length() == 2 * n) {
            ans.push_back(path);
            return;
        }

        // Choose (
        if (open < n) {
            solve(open + 1, close, n, path + "(");
        }

        // Choose )
        if (close < open) {
            solve(open, close + 1, n, path + ")");
        }
    }

    vector<string> generateParenthesis(int n) {

        solve(0, 0, n, "");

        return ans;
    }
};
