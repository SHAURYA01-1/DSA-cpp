class Solution {
public:
    vector<vector<int>> ans;

    void solve(int index, int target,
               vector<int>& candidates,
               vector<int>& path) {

        // Base case: valid combination found
        if (target == 0) {
            ans.push_back(path);
            return;
        }

        // Try every candidate starting from index
        for (int i = index; i < candidates.size(); i++) {

            //skip Duplicates
            if(i  >  index && candidates[i] == candidates[i-1]){
            continue;
            }


            // Skip if candidate is greater than target
            if (candidates[i] > target) {
                continue;
            }

            // Choose
            path.push_back(candidates[i]);

            // Explore
            // i is passed again because we can reuse the same number
            solve(i+1, target - candidates[i], candidates, path);

            // Backtrack
            path.pop_back();
        }
    }

    vector<vector<int>> combinationSum2(vector<int>& candidates, int target) {

        // Important: sort for duplicate handling
        sort(candidates.begin(), candidates.end());
        
        vector<int> path;

        solve(0, target, candidates, path);

        return ans;

    }
};
